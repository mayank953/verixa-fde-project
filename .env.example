# Copy to .env and fill in. This file holds placeholders only: never put a real key in it.
# Your own Gemini key (free tier works): https://aistudio.google.com/apikey
GOOGLE_API_KEY=put-your-gemini-key-here

# sample = recorded fictional examples for every outside service (no keys, no cost, no real person is looked up)
# live   = the real services; needs SERP_API_KEY and APIFY_API_TOKEN below
EXTERNAL_MODE=sample

# Local databases (see docker-compose.yml)
DATABASE_URL=postgresql://fraud_user:password@localhost:5432/fraud_db
NEO4J_URI=bolt://localhost:7687
NEO4J_PASSWORD=password

# Login tokens. Change this to any long random text.
JWT_SECRET=change-me-to-a-long-random-text

# Only for EXTERNAL_MODE=live
SERP_API_KEY=
APIFY_API_TOKEN=
LINKEDIN_ACTOR_ID=
YOUTUBE_ACTOR_ID=
GOOGLE_SEARCH_ACTOR_ID=
